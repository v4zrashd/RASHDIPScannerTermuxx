def range_scan():
    cidr = input(f"  {Y}Enter CIDR (e.g. 192.168.1.0/24) › {N}").strip()
    if not cidr:
        return
    try:
        net = ipaddress.ip_network(cidr, strict=False)
    except Exception as e:
        print(f"  {R}❌ Bad CIDR: {e}{N}\n")
        return
    hosts = list(net.hosts())
    if len(hosts) > 1024:
        print(f"  {R}❌ Too many hosts ({len(hosts)}). Max /22 (1024).{N}\n")
        return
    print(f"\n  {W}📡 Scanning {len(hosts)} hosts...{N}\n")

    def check_host(ip):
        ip = str(ip)
        for port in (80, 443, 8080, 22):
            if is_open(ip, port, 1.0):
                return ip, port
        return ip, None

    live = []
    try:
        with ThreadPoolExecutor(max_workers=200) as ex:
            for ip, port in ex.map(check_host, hosts):
                if port:
                    live.append((ip, port))
                    server, title = ("—", "—")
                    if port in (80, 8080, 443):
                        server, title = grab_http(ip, port)
                    host = reverse_dns(ip)
                    print(f"  {G}● {ip}{N}  {W}port {port}{N}  host: {host}")
                    print(f"    {C}Server:{N} {server}  {C}Title:{N} {title}")
    except KeyboardInterrupt:
        print(f"\n  {Y}⏹ Stopped by user.{N}")
    print(f"\n  {G}✓ Done — {len(live)} live host(s).{N}")
    if live:
        with open("v4zscan_result.txt", "a") as f:
            for ip, port in live:
                f.write(f"[range] {ip}:{port}\n")
        print(f"  {G}✓ Saved to v4zscan_result.txt{N}\n")


def port_scan(deep):
    ip_in = input(f"  {Y}Enter IP or domain › {N}").strip()
    if not ip_in:
        return
    try:
        try:
            ipaddress.ip_address(ip_in)
            ip, label = ip_in, ip_in
        except ValueError:
            label, ip = resolve_domain(ip_in)
    except Exception as e:
        print(f"  {R}❌ Bad target: {e}{N}\n")
        return

    if deep:
        ports = range(1, 65536)
        workers, timeout = 300, 0.8
        print(f"\n  {W}⚡ Deep scan {ip} — all 65535 ports (CTRL+C to stop)...{N}\n")
    else:
        ports = COMMON_PORTS
        workers, timeout = 40, 1.5
        print(f"\n  {W}🔍 Quick scan {ip} — {len(ports)} common ports...{N}\n")

    open_ports = []
    t0 = time.time()
    try:
        with ThreadPoolExecutor(max_workers=workers) as ex:
            for port, open_ in ex.map(lambda p: (p, is_open(ip, p, timeout)), ports):
                if open_:
                    open_ports.append(port)
                    name = PORT_NAMES.get(port, "")
                    print(f"  {G}● OPEN{N} {W}{port}{N} {M}{name}{N}")
    except KeyboardInterrupt:
        print(f"\n  {Y}⏹ Stopped by user.{N}")
    dt = time.time() - t0
    print(f"\n  {G}✓ Done in {dt:.1f}s — {len(open_ports)} open port(s).{N}")
    if open_ports:
        with open("v4zscan_result.txt", "a") as f:
            f.write(f"[ports] {label} ({ip}) open: {open_ports}\n")
        print(f"  {G}✓ Saved to v4zscan_result.txt{N}")
    print()


