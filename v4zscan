def resolve_domain(domain):
    domain = domain.strip().lower()
    for prefix in ("http://", "https://", "www."):
        if domain.startswith(prefix):
            domain = domain[len(prefix):]
    domain = domain.split("/")[0]
    return domain, socket.gethostbyname(domain)


def reverse_dns(ip):
    try:
        return socket.gethostbyaddr(ip)[0]
    except Exception:
        return "—"


def grab_http(ip, port, timeout=5):
    """Return (server_header, page_title) from an HTTP(S) port."""
    server, title = "—", "—"
    try:
        s = socket.create_connection((ip, port), timeout=timeout)
        s.settimeout(timeout)
        s.sendall(f"GET / HTTP/1.0\r\nHost: {ip}\r\nUser-Agent: V4Z-Scanner\r\n\r\n".encode())
        data = b""
        try:
            while True:
                chunk = s.recv(4096)
                if not chunk:
                    break
                data += chunk
                if len(data) > 32768 or b"</title>" in data.lower():
                    break
        except socket.timeout:
            pass
        s.close()
        text = data.decode("utf-8", "replace")
        head, _, _ = text.partition("\r\n\r\n")
        m = re.search(r"(?im)^server:\s*(.+)$", head)
        if m:
            server = m.group(1).strip()[:60]
        m = re.search(r"<title[^>]*>(.*?)</title>", text, re.I | re.S)
        if m:
            title = re.sub(r"\s+", " ", m.group(1)).strip()[:80] or "—"
    except Exception:
        pass
    return server, title


def is_open(ip, port, timeout=1.0):
    try:
        s = socket.create_connection((ip, port), timeout=timeout)
        s.close()
        return True
    except Exception:
        return False


